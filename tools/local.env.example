# Settings of one machine. Copy to tools/local.env (which is not kept in the repository) and adjust.
# tools/build-tv.sh and tools/tv.sh read it by themselves; for the node tools, load it into your shell first (. tools/local.env).

# The TV's address on your network (TV: Settings → Network → Network Status → IP Settings)
export TV=192.168.1.50

# The Tizen command-line tools, if they are not on PATH already (Tizen Studio's default folder is ~/tizen-studio)
export PATH="$HOME/tizen-studio/tools:$HOME/tizen-studio/tools/ide/bin:$PATH"

# Optional default for tools/build-tv.sh. A profile passed on the command line takes precedence.
# export TIZEN_PROFILE=tv

# Optional — a specific browser for the PC-side tools (default: a system Chromium/Chrome, else Playwright's own)
# export CHROMIUM=/usr/bin/chromium
# Optional — an older Chromium for tools/oldchrome.mjs
# export OLD_CHROMIUM=/path/to/chrome-linux/chrome

# Optional — only for machines without a desktop (see tools/headless in the README)
# export TIZEN_KIT=/path/to/the/folder/holding/tizen-studio        # also holds secrets/ and the helper's working files
# export PROFILE_PASSWORDS=$TIZEN_KIT/secrets                        # <profile>-author.pass, <profile>-dist.pass
